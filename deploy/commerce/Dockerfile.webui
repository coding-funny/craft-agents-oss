FROM oven/bun:1.4.2-slim AS build
WORKDIR /app
COPY . .
RUN bun install --frozen-lockfile
ARG VITE_COMMERCE_API_BASE=/commerce-api
ENV VITE_COMMERCE_API_BASE=$VITE_COMMERCE_API_BASE
RUN bun run webui:build

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY deploy/commerce/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/webui/dist /usr/share/nginx/html
EXPOSE 8080
