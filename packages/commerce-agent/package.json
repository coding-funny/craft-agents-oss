{
  "name": "@craft-agent/commerce-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:mcp": "bun test tests/mcp-schemas.test.ts tests/tool-runner.test.ts tests/setup.test.ts tests/mcp-integration.test.ts tests/report.test.ts tests/diagnosis.test.ts tests/approval-execution.test.ts tests/recovery.test.ts tests/demo.test.ts tests/eval.test.ts",
    "test:agent": "bun test tests/agent",
    "test:agent:contracts": "bun test tests/agent/task-contracts.test.ts tests/agent/state-machine.test.ts tests/agent/budget.test.ts tests/agent/context-manager.test.ts",
    "test:agent:mcp": "bun test tests/agent/tool-dispatcher.test.ts tests/agent/investigation-runner.test.ts",
    "test:storage": "bun test tests/storage/data-repository.test.ts",
    "test:imports": "bun test tests/imports",
    "test:evidence": "bun test tests/evidence.test.ts tests/evidence",
    "test:postgres": "bun run tests/storage/postgres-integration.ts",
    "import": "bun run src/cli/import-data.ts",
    "db:migrate": "bun run src/cli/db-migrate.ts",
    "investigate": "bun run src/cli/investigate.ts",
    "investigation:status": "bun run src/cli/investigation-status.ts",
    "eval:agent": "bun run evals/agent/runner.ts",
    "eval": "bun run evals/runner.ts",
    "eval:failures": "bun run evals/failure-injection.ts",
    "demo": "bun run demo/run-demo.ts",
    "server": "bun run src/mcp/server.ts",
    "api": "bun run src/api/server.ts",
    "test:auth": "bun test tests/auth tests/api tests/approval-policy",
    "setup": "bun run src/setup/cli.ts",
    "demo:diagnose": "bun run src/demo/diagnose.ts",
    "demo:proposal": "bun run src/cli/create-proposal.ts",
    "approve": "bun run src/cli/approve.ts",
    "reject": "bun run src/cli/reject.ts",
    "execute": "bun run src/cli/execute.ts",
    "reconcile": "bun run src/cli/reconcile.ts"
  },
  "dependencies": {
    "@craft-agent/shared": "workspace:*",
    "@earendil-works/pi-ai": "0.85.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "jose": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.0.8",
    "typescript": "^5.0.0"
  }
}
